# Copy this file to ".env" in the same folder and fill in your own values.
# NEVER commit the real .env file to GitHub.

PORT=5000
CLIENT_URL=http://localhost:5173

# From MongoDB Atlas: Connect > Drivers. Put the database name "notehub" before the "?"
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/notehub?retryWrites=true&w=majority

# Any long random text. Used to sign login tokens.
JWT_SECRET=change-this-to-a-long-random-text

# Used once by "npm run seed:admin" to create the first admin account
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=choose-a-strong-password

# Needed later for FR-12 (AI summary and tags). Free key from Google AI Studio.
GEMINI_API_KEY=
